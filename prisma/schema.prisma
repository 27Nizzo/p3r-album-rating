datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  favorites     Favorite[]
  likes         ReviewLike[]
  comments      Comment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
}

model Favorite {
  id            String @id @default(cuid())
  albumId       String
  albumTitle    String
  artistName    String
  coverUrl      String
  releaseYear   String
  createdAt     DateTime @default(now())

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, albumId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Review {
  id          String   @id @default(cuid())
  albumId     String
  albumTitle  String
  artistName  String
  coverUrl    String
  releaseYear String
  rating      Int
  comment     String
  likes       ReviewLike[]
  comments    Comment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ReviewLike {
  id          String   @id  @default(cuid())
  userId      String
  reviewId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  review      Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([userId, reviewId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}